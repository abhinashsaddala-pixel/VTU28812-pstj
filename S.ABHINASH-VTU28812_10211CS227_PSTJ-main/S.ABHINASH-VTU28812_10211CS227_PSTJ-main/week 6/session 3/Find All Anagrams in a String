import java.util.ArrayList;
import java.util.List;

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();
        
        // Edge case: if s is shorter than p, s cannot contain any anagrams of p
        if (s.length() < p.length()) {
            return result;
        }

        // Frequency arrays for 'p' and the sliding window in 's'
        int[] pCount = new int[26];
        int[] sCount = new int[26];

        // Populate frequency counts for string p and the first window in string s
        for (int i = 0; i < p.length(); i++) {
            pCount[p.charAt(i) - 'a']++;
            sCount[s.charAt(i) - 'a']++;
        }

        // Check the first window
        if (matches(pCount, sCount)) {
            result.add(0);
        }

        // Slide the window across string s
        int windowSize = p.length();
        for (int i = windowSize; i < s.length(); i++) {
            // Add the new character entering the window
            sCount[s.charAt(i) - 'a']++;
            // Remove the character leaving the window
            sCount[s.charAt(i - windowSize) - 'a']--;

            // If the frequencies match, store the start index of the current window
            if (matches(pCount, sCount)) {
                result.add(i - windowSize + 1);
            }
        }

        return result;
    }

    // Helper method to compare two frequency arrays of size 26
    private boolean matches(int[] a, int[] b) {
        for (int i = 0; i < 26; i++) {
            if (a[i] != b[i]) {
                return false;
            }
        }
        return true;
    }
}
