class Solution {
    public String dayOfTheWeek(int day, int month, int year) {
        String[] days = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
        int[] daysInMonth = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        
        // Jan 1, 1971 was Friday. Index 5 in days array:
        // Sunday (0), Monday (1), Tuesday (2), Wednesday (3), Thursday (4), Friday (5), Saturday (6)
        int totalDays = 0;
        
        // 1. Add days for all elapsed years since 1971
        for (int y = 1971; y < year; y++) {
            if (isLeapYear(y)) {
                totalDays += 366;
            } else {
                totalDays += 365;
            }
        }
        
        // 2. Add days for elapsed months in current year
        for (int m = 1; m < month; m++) {
            if (m == 2 && isLeapYear(year)) {
                totalDays += 29;
            } else {
                totalDays += daysInMonth[m - 1];
            }
        }
        
        // 3. Add remaining days in the current month (day - 1 because Jan 1 is day 1)
        totalDays += (day - 1);
        
        // Offset by 5 because Jan 1, 1971 was Friday (index 5)
        return days[(totalDays + 5) % 7];
    }
    
    private boolean isLeapYear(int year) {
        return (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
    }
}
