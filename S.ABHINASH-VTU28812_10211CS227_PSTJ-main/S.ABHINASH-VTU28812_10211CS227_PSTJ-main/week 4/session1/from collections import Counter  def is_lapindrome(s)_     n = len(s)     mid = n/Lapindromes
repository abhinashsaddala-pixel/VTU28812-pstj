from collections import Counter

def is_lapindrome(s):
    n = len(s)
    mid = n // 2
    
    if n % 2 == 0:
        left, right = s[:mid], s[mid:]
    else:
        left, right = s[:mid], s[mid+1:]
    
    return Counter(left) == Counter(right)

# Driver code
T = int(input().strip())
for _ in range(T):
    s = input().strip()
    print("YES" if is_lapindrome(s) else "NO")
