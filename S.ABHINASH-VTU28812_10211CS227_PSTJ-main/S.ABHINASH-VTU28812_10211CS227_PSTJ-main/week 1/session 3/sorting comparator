import java.util.*;

// Player class is already provided in the stub
class Player {
    String name;
    int score;
    
    Player(String name, int score) {
        this.name = name;
        this.score = score;
    }
}

// Comparator implementation
class Checker implements Comparator<Player> {
    @Override
    public int compare(Player a, Player b) {
        // Sort by score in descending order
        if (a.score != b.score) {
            return b.score - a.score; 
        }
        // If scores are equal, sort by name in ascending order
        return a.name.compareTo(b.name);
    }
}

public class Solution {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt(); // number of players
        Player[] players = new Player[n];
        
        for (int i = 0; i < n; i++) {
            players[i] = new Player(sc.next(), sc.nextInt());
        }
        
        // Use the Checker comparator to sort
        Arrays.sort(players, new Checker());
        
        // Print sorted players
        for (Player p : players) {
            System.out.println(p.name + " " + p.score);
        }
        
        sc.close();
    }
}
