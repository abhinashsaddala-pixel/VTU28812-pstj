import java.util.*;

public class test {
    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);
        Deque<Integer> deque = new ArrayDeque<>();
        Set<Integer> set = new HashSet<>();
        
        int n = in.nextInt();
        int m = in.nextInt();
        int maxUnique = 0;

        for (int i = 0; i < n; i++) {
            int num = in.nextInt();
            
            deque.addLast(num);
            set.add(num);
            
            if (deque.size() == m) {
                // Update the maximum unique elements count found so far
                if (set.size() > maxUnique) {
                    maxUnique = set.size();
                }
                
                // If maximum possible unique count is achieved, exit early
                if (maxUnique == m) {
                    break;
                }
                
                // Remove the oldest element
                int removed = deque.removeFirst();
                
                // Only remove from set if the element isn't repeated in the current window
                if (!deque.contains(removed)) {
                    set.remove(removed);
                }
            }
        }
        
        System.out.println(maxUnique);
    }
}
